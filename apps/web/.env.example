# Where the Vite dev/preview server proxies /api requests.
API_PROXY_TARGET=http://localhost:4000

# Optional: the origin serving live updates (Socket.IO), when it is not this site.
# Leave empty to use this site's /api, which the dev server proxies.
VITE_REALTIME_URL=

# The site's public address, used in link previews (Open Graph tags). Set it in production,
# e.g. https://formyx.app. Defaults to http://localhost:5173.
VITE_APP_URL=

# Show "Try the demo" on the landing page. The API needs DEMO_ENABLED=true as well.
VITE_DEMO_ENABLED=false

# Error monitoring: a Sentry project DSN (a browser one; it is public by design). Sentry loads
# after the page settles, in a chunk of its own. Empty: errors stay in the browser console.
VITE_SENTRY_DSN=
# The release errors are filed under, e.g. the commit (Vercel: $VERCEL_GIT_COMMIT_SHA).
VITE_SENTRY_RELEASE=

# Vercel builds only: where the API runs. /api/* is proxied there (see build/vercel-output.ts).
# API_URL=https://formyx-api.onrender.com

# Razorpay Checkout's script. Leave empty for Razorpay's own; end-to-end tests use a stand-in.
VITE_RAZORPAY_CHECKOUT_URL=
