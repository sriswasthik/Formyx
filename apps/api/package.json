{
  "name": "@formyx/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@formyx/source --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed:demo": "tsx --conditions=@formyx/source --env-file-if-exists=.env src/demo/reset-demo.ts",
    "demo:reset": "node --env-file-if-exists=.env dist/demo/reset-demo.js",
    "jobs:run": "tsx --conditions=@formyx/source --env-file-if-exists=.env src/jobs/run-jobs.ts",
    "jobs": "node --env-file-if-exists=.env dist/jobs/run-jobs.js",
    "jobs:worker": "node --env-file-if-exists=.env dist/jobs/worker.js",
    "db:migrate-forms": "tsx --conditions=@formyx/source --env-file-if-exists=.env src/scripts/migrate-forms.ts",
    "forms:migrate": "node --env-file-if-exists=.env dist/scripts/migrate-forms.js",
    "keys:new": "tsx src/scripts/new-key.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@formyx/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^11.6.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg-boss": "^12.37.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.31.0",
    "satori": "^0.47.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
