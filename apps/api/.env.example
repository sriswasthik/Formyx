# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Express "trust proxy". Behind one load balancer use 1, so rate limiting sees real client IPs.
TRUST_PROXY=false

# PostgreSQL connection string. The default matches docker-compose.yml.
# With Neon, use the pooled connection string here and set DIRECT_URL below.
DATABASE_URL=postgresql://formyx:formyx@localhost:5432/formyx

# Optional: direct (non-pooled) connection used by Prisma migrations.
# DIRECT_URL=

# Database used by `pnpm test`. Its name must end in _test, because tests empty it.
TEST_DATABASE_URL=postgresql://formyx:formyx@localhost:5432/formyx_test

# Signs session tokens. Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# bcrypt work factor (4-15). Each step doubles hashing time.
BCRYPT_COST=12

# Sign-ups and failed log-ins allowed per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=10

# Form submissions allowed per IP per form per 15 minutes.
SUBMISSION_RATE_LIMIT_MAX=10

# Invite emails (new or sent again) each user may send per 15 minutes.
INVITE_RATE_LIMIT_MAX=20

# API requests allowed per signed-in user (or per IP when signed out) per 15 minutes, outside
# the public form endpoints, which have their own limits. A ceiling for floods and scripts.
API_RATE_LIMIT_MAX=3000

# Let webhooks use http:// and reach localhost or private networks. Development only:
# never enable this on a server.
WEBHOOK_ALLOW_PRIVATE_URLS=false

# Shared demo account behind "Try the demo" (set VITE_DEMO_ENABLED in the web app too).
# It is set up on the first visit; reset it with `pnpm --filter @formyx/api db:seed:demo`
# (or `demo:reset` after a build, e.g. from a nightly cron job).
DEMO_ENABLED=false

# Plans and features. all_unlocked (development and the beta): every workspace gets every
# feature. enforced: each workspace gets what its plan includes, and publishing a form that
# uses Pro features (fonts, textures, mesh gradients...) needs a plan that includes them.
ENTITLEMENTS_MODE=all_unlocked
# Once a workspace has had its plan's responses for the month: soft keeps accepting them (and
# warns the owners); hard tells new visitors the form isn't taking responses. Responses already
# being filled in are always saved.
ENFORCEMENT_MODE=soft

# Where the web app is served, for links in notification emails.
APP_URL=http://localhost:5173

# Resend API key for notification emails (https://resend.com/api-keys).
# Leave empty in development: emails are then written to the log instead of sent.
RESEND_API_KEY=

# Sender of notification emails. Its domain must be verified in Resend.
EMAIL_FROM=Formyx <notifications@formyx.app>

# Development only, without Resend: also save each email as a JSON file in this folder, so
# links in them (such as invites) can be opened. Ignored in production.
EMAIL_OUTBOX_DIR=

# Cloudinary account for file uploads (https://console.cloudinary.com). Respondents' files
# and form logos upload straight from the browser; the API only signs uploads and checks
# them. Leave these empty to switch uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level Cloudinary folder for this app's files.
CLOUDINARY_FOLDER=formyx
# Cloudinary's API. Leave as is; end-to-end tests point it at e2e/scripts/fake-cloudinary.mjs.
CLOUDINARY_API_URL=https://api.cloudinary.com

# Looks up Indian PIN codes for address questions (India Post's free public API). Answers
# are cached in memory; if it is down, respondents type city and state themselves.
PINCODE_API_URL=https://api.postalpincode.in/pincode

# Keys that seal secrets at rest: integration tokens, webhook signing secrets and chat
# webhook URLs. `<id>:<base64 32-byte key>`, comma-separated, newest first; make one with
# `pnpm --filter @formyx/api keys:new`. To rotate, put a new key first and keep the old one
# after it until everything has been sealed again. Empty: a key is derived from JWT_SECRET
# (fine for development; in production it ties stored secrets to the session secret).
ENCRYPTION_KEYS=

# Background jobs (webhooks, response emails, chat posts, integrations, hourly upkeep) run in
# this process (on). `off` only queues them, for when `pnpm jobs:worker` runs separately.
# The queue lives in Postgres (pg-boss, schema "pgboss") and uses DIRECT_URL when set.
WORKERS=on

# Google (https://console.cloud.google.com/apis/credentials), for "Continue with Google" and
# Google Sheets: an OAuth client of type "Web application" with two redirect URIs,
# <APP_URL>/api/auth/oauth/google/callback (sign-in) and
# <APP_URL>/api/integrations/google/callback (Sheets), and the Google Sheets API enabled.
# Leave empty to switch both off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google's endpoints. Leave as they are; end-to-end tests point them at a fake Google.
GOOGLE_OAUTH_URL=https://accounts.google.com
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com
GOOGLE_SHEETS_URL=https://sheets.googleapis.com

# Zoho (https://api-console.zoho.com), for "Continue with Zoho": a "Server-based Application"
# client with the redirect URI <APP_URL>/api/auth/oauth/zoho/callback. Turn on "Multi-DC" in its
# settings so people from every Zoho data centre can sign in. Leave empty to hide the button.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# The data centre the client was made in: https://accounts.zoho.com, https://accounts.zoho.in,
# https://accounts.zoho.eu... End-to-end tests point it at a fake Zoho.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Notion (https://www.notion.so/my-integrations): a public integration with the redirect URI
# <APP_URL>/api/integrations/notion/callback. Leave empty to switch the integration off.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_API_URL=https://api.notion.com

# Error monitoring: a Sentry project DSN. Only errors are sent, without IPs, cookies,
# headers, query strings or bodies. Empty: errors are only logged.
SENTRY_DSN=

# Product analytics: a PostHog project API key, and its region's host. A few server-side events
# (sign-ups, forms created and published, premium looks used, integrations connected, feedback,
# trials, checkouts and cancellations),
# with hashed ids and no person profiles; people can turn it off in their preferences.
# Empty: nothing is sent.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Razorpay subscriptions (https://dashboard.razorpay.com, test mode). Only test keys
# (rzp_test_...) are accepted for now. Add a webhook pointing at <API>/api/webhooks/razorpay for
# the subscription.* and payment.failed events, with RAZORPAY_WEBHOOK_SECRET as its secret. Make
# the four plans with `pnpm --filter @formyx/api billing:sync-plans -- --create`, which also
# checks them against the prices in packages/shared. Without all of these, checkout is off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_YEARLY=
# Razorpay's API. Leave as it is; end-to-end tests point it at a fake Razorpay.
RAZORPAY_API_URL=https://api.razorpay.com
# Real payments. Live keys (rzp_live_) are refused unless this is true, and test keys when it is.
# Switch it on only after a final run through checkout in test mode: docs/launch-checklist.md.
RAZORPAY_LIVE=false

# Where feedback sent from the app is emailed. Empty: it is only stored (see the feedback table).
FEEDBACK_EMAIL=

# Trust and safety (Sprint 21).
# Publishing needs a confirmed email address. Leave off until emails reach everyone (a domain
# verified in Resend); Google and Zoho accounts are confirmed already.
REQUIRE_EMAIL_VERIFICATION=off
# Limits for accounts in their first 72 hours (fewer responses, no redirects or autoresponders).
# Leave on; end-to-end tests switch it off.
NEW_ACCOUNT_LIMITS=on
# Google Safe Browsing API key (https://developers.google.com/safe-browsing): links in forms and
# webhook addresses are also looked up there. Empty: only the built-in blocklist is used.
GOOGLE_SAFE_BROWSING_KEY=
SAFE_BROWSING_URL=https://safebrowsing.googleapis.com
# More domains to refuse in links and webhooks, comma-separated.
BLOCKED_LINK_DOMAINS=
# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile), the spam check forms
# may switch on. Empty in development: Cloudflare's always-passing test keys. Empty in
# production: the option is hidden.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_URL=https://challenges.cloudflare.com
