// Formyx database schema. After editing, run `pnpm db:migrate` to create a migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// What a member may do in a workspace. Ordered from most to least access.
enum Role {
  OWNER
  EDITOR
  VIEWER

  @@map("role")
}

model User {
  id              String             @id @default(cuid())
  name            String
  /// Stored trimmed and lowercased, so the unique index is effectively case-insensitive.
  email           String             @unique
  passwordHash    String             @map("password_hash")
  /// The shared demo account (see src/demo). It signs in without a password, its data is
  /// reset every night, and anything that reaches outside Formyx is switched off for it.
  isDemo          Boolean            @default(false) @map("is_demo")
  /// Goes up when the password changes; sessions carry it, so older ones stop working.
  passwordVersion Int                @default(0) @map("password_version")
  /// The person's own preferences (see `accountPreferencesSchema` in packages/shared).
  preferences     Json               @default("{}")
  /// May use /admin. Set only from the command line (`admin:grant`), never through the API.
  isAdmin         Boolean            @default(false) @map("is_admin")
  /// When a workspace they own started its free trial: one trial per account.
  trialUsedAt     DateTime?          @map("trial_used_at")
  /// The welcome and getting-started checklist (`onboardingStateSchema` in packages/shared).
  /// Empty for accounts from before onboarding, which never see either.
  onboarding      Json               @default("{}")
  /// When they last used the app, to the hour (set by `requireAuth`); for the "we miss you"
  /// email. Null until they first come back after it shipped.
  lastActiveAt    DateTime?          @map("last_active_at")
  /// Their referral link's code (`/?ref=<code>`), made the first time they look at it.
  referralCode    String?            @unique @map("referral_code")
  /// What brought them, when known (`signupSourceSchema`): the badge on a free form, say.
  signupSource    String?            @map("signup_source")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  memberships     Membership[]
  forms           Form[]
  subscriptions   FormSubscription[]
  invitesSent     Invite[]
  webhooks        Webhook[]
  brandKits       BrandKit[]
  integrations    Integration[]
  feedback        Feedback[]
  adminActions    AdminAction[]
  lifecycleEmails LifecycleEmail[]
  referralsMade   Referral[]         @relation("referrer")
  referredBy      Referral?          @relation("friend")

  @@index([lastActiveAt])
  @@map("users")
}

/// What a workspace pays for. Read through the shared entitlement helpers, never by name.
enum Plan {
  FREE
  PRO
  BUSINESS

  @@map("plan")
}

/// Where a workspace's billing stands; see `effectivePlan` in packages/shared.
enum PlanStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED

  @@map("plan_status")
}

model Workspace {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  /// What the workspace pays for (or is trying), kept in step with its subscription by
  /// Razorpay's webhooks. ENTITLEMENTS_MODE decides whether it matters.
  plan               Plan            @default(FREE)
  planStatus         PlanStatus      @default(ACTIVE) @map("plan_status")
  /// When a TRIALING plan falls back to FREE.
  trialEndsAt        DateTime?       @map("trial_ends_at")
  /// When a PAST_DUE plan falls back to FREE, if payment has not come by then.
  graceEndsAt        DateTime?       @map("grace_ends_at")
  /// A plan given by an admin (testers, friends), on top of what is paid for, until
  /// `complimentaryUntil`.
  complimentaryPlan  Plan?           @map("complimentary_plan")
  complimentaryUntil DateTime?       @map("complimentary_until")
  /// The Razorpay customer that pays for it, made with its first subscription. Not unique:
  /// Razorpay keeps one customer per email, so an owner paying for two workspaces is one.
  razorpayCustomerId String?         @map("razorpay_customer_id")
  /// The plan it had before it last fell back to FREE, and when: shown as "what changed"
  /// until the owner dismisses it or upgrades.
  downgradedFrom     Plan?           @map("downgraded_from")
  downgradedAt       DateTime?       @map("downgraded_at")
  /// The brand kit new forms start with. Cleared when that kit is deleted.
  defaultBrandKitId  String?         @unique @map("default_brand_kit_id")
  /// Time zone, date format and new forms' notifications (`workspacePreferencesSchema`).
  preferences        Json            @default("{}")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  memberships        Membership[]
  forms              Form[]
  invites            Invite[]
  brandKits          BrandKit[]      @relation("WorkspaceBrandKits")
  defaultBrandKit    BrandKit?       @relation("DefaultBrandKit", fields: [defaultBrandKitId], references: [id], onDelete: SetNull)
  subscriptions      Subscription[]
  payments           Payment[]
  billingNotices     BillingNotice[]

  @@map("workspaces")
}

/// A workspace's logo, colours and fonts, saved from a form's theme and applied to others.
model BrandKit {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  name        String
  /// Validated with the shared `brandKitDataSchema`.
  kit         Json
  /// Null once its creator's account is deleted; the kit stays with its workspace.
  createdById String?    @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  workspace   Workspace  @relation("WorkspaceBrandKits", fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  defaultFor  Workspace? @relation("DefaultBrandKit")

  // Listed per workspace, newest first.
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("brand_kits")
}

model Membership {
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  role        Role
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One membership per user per workspace; the primary key also serves lookups by user.
  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

/// An invitation to join a workspace, sent by email. The link carries a random token; only
/// its SHA-256 is stored, so the table alone cannot be used to join.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  /// Stored trimmed and lowercased, like users' emails. Only this address can accept.
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String?   @map("invited_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Moves forward when the invite is sent again.
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@map("invites")
}

/// Where a form is in its life. Only PUBLISHED forms accept responses.
enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@map("form_status")
}

model Form {
  id                      String                   @id @default(cuid())
  workspaceId             String                   @map("workspace_id")
  title                   String
  /// Identifies the form's public link. Never changes, so shared links keep working.
  slug                    String                   @unique
  status                  FormStatus               @default(DRAFT)
  /// The schema being edited. Every write is validated with the shared `formSchema`.
  draftSchema             Json                     @map("draft_schema")
  /// What respondents see: a snapshot of the draft, taken each time the form is published.
  publishedSchema         Json?                    @map("published_schema")
  /// The title as last published, so renames go live with the next publish.
  publishedTitle          String?                  @map("published_title")
  /// The look being edited. Validated with the shared `formThemeSchema`.
  theme                   Json
  /// What respondents see: a snapshot of `theme`, taken each time the form is published.
  publishedTheme          Json?                    @map("published_theme")
  /// Incremented on every draft update. Writers send the version they started from (optimistic concurrency).
  version                 Int                      @default(1)
  /// When the form was last published.
  publishedAt             DateTime?                @map("published_at")
  /// Access, notifications, autoresponder, sharing and data settings, which take effect as
  /// they are saved (`liveSettingsSchema` in packages/shared). Never sent to respondents.
  liveSettings            Json                     @default("{}") @map("live_settings")
  /// bcrypt of the form's password; null when it has none.
  passwordHash            String?                  @map("password_hash")
  /// Goes up when the password changes, so tokens from unlocking it before stop working.
  passwordVersion         Int                      @default(0) @map("password_version")
  /// Chat webhook URLs, encrypted like webhook secrets: the URL is the credential.
  slackWebhookEncrypted   String?                  @map("slack_webhook_encrypted")
  discordWebhookEncrypted String?                  @map("discord_webhook_encrypted")
  /// When the last daily digest of responses went out.
  lastDigestAt            DateTime?                @map("last_digest_at")
  /// Null once the creator's account is deleted; the form stays with its workspace.
  createdById             String?                  @map("created_by_id")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy               User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  submissions             Submission[]
  views                   FormView[]
  drafts                  FormDraft[]
  oldSlugs                FormSlug[]
  verifications           RespondentVerification[]
  autoreplies             AutoresponderSend[]
  subscriptions           FormSubscription[]
  webhooks                Webhook[]
  integrations            Integration[]
  jobFailures             JobFailure[]

  // The dashboard lists a workspace's forms, most recently edited first, optionally by status.
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([createdById])
  @@map("forms")
}

model Submission {
  id                 String              @id @default(cuid())
  formId             String              @map("form_id")
  /// Answers keyed by field id, validated and normalised with the published schema.
  answers            Json
  /// Milliseconds from opening the form to submitting it, as measured by the browser.
  completionTimeMs   Int?                @map("completion_time_ms")
  /// Client details: user agent and referrer. IP addresses are never stored.
  metadata           Json
  /// Route, values, quiz mark and end screen, worked out by the server (never the client).
  /// Null for responses from before Sprint 13.
  outcome            Json?
  /// The address given before the questions, when the form asks for one.
  respondentEmail    String?             @map("respondent_email")
  /// SHA-256 of the verified, normalised address, for one response per person. Unique per
  /// form; null when the form does not verify addresses.
  respondentKey      String?             @map("respondent_key")
  /// SHA-256 of the token in the private link that changes this response.
  editTokenHash      String?             @unique @map("edit_token_hash")
  editedAt           DateTime?           @map("edited_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  form               Form                @relation(fields: [formId], references: [id], onDelete: Cascade)
  integrationRecords IntegrationRecord[]

  @@unique([formId, respondentKey])
  // Responses are counted per form and listed newest first.
  @@index([formId, createdAt(sort: Desc)])
  @@map("submissions")
}

/// One visit to a published form, recorded once per browser session. Rows rather than a
/// counter, so views can be charted over time and compared with submissions. Visits also
/// report how far they got, for drop-off analytics: anonymously, under a random token that
/// identifies the visit and nothing else.
model FormView {
  id            String    @id @default(cuid())
  formId        String    @map("form_id")
  /// Random, given to the browser; ties progress reports to this visit. Null before Sprint 13.
  token         String?   @unique
  /// The furthest page shown (`start` or a page break's id).
  furthestPage  String?   @map("furthest_page")
  /// The last question answered, furthest in form order.
  furthestField String?   @map("furthest_field")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  form          Form      @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@map("form_views")
}

/// Answers a respondent saved to finish later, reached through an emailed link. Only a hash
/// of the link's token is kept, and never the email address.
model FormDraft {
  id        String   @id @default(cuid())
  formId    String   @map("form_id")
  /// SHA-256 of the token in the link, hex.
  tokenHash String   @unique @map("token_hash")
  answers   Json
  /// Where they were: page and shuffle seed.
  state     Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([expiresAt])
  @@map("form_drafts")
}

/// A member who wants an email about each new response to a form. Each member decides for
/// themselves, and it takes effect at once rather than with the next publish.
model FormSubscription {
  userId    String   @map("user_id")
  formId    String   @map("form_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@id([userId, formId])
  // A new response looks up who to email by form.
  @@index([formId])
  @@map("form_subscriptions")
}

/// A URL that gets a signed POST for each new response to a form.
model Webhook {
  id              String            @id @default(cuid())
  formId          String            @map("form_id")
  url             String
  /// The signing secret, encrypted with a key derived from JWT_SECRET (see webhook-signature.ts).
  /// It is shown once, when the webhook is added; Formyx needs it back only to sign requests.
  secretEncrypted String            @map("secret_encrypted")
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  form            Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deliveries      WebhookDelivery[]

  @@index([formId])
  @@map("webhooks")
}

/// One attempt to deliver an event; the newest few per webhook are kept for its log.
model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String   @map("webhook_id")
  /// Shared by every attempt at one event; sent as X-Formyx-Delivery.
  eventId    String   @map("event_id")
  event      String
  attempt    Int
  succeeded  Boolean
  /// The receiver's HTTP status; null when no response came back.
  statusCode Int?     @map("status_code")
  durationMs Int?     @map("duration_ms")
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

/// Addresses a form used before its slug changed. They keep working: the public page asks
/// for the old one and is sent to the form's current address.
model FormSlug {
  slug      String   @id
  formId    String   @map("form_id")
  createdAt DateTime @default(now()) @map("created_at")
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_slugs")
}

/// A code emailed to confirm a respondent's address, for forms taking one response per
/// person. Only hashes are kept: of the address and of the code.
model RespondentVerification {
  id        String   @id @default(cuid())
  formId    String   @map("form_id")
  emailHash String   @map("email_hash")
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, emailHash])
  @@index([expiresAt])
  @@map("respondent_verifications")
}

/// One autoresponder email sent, so a form never sends one address more than a few a day.
model AutoresponderSend {
  id        String   @id @default(cuid())
  formId    String   @map("form_id")
  emailHash String   @map("email_hash")
  createdAt DateTime @default(now()) @map("created_at")
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, emailHash, createdAt])
  @@map("autoresponder_sends")
}

enum IntegrationKind {
  GOOGLE_SHEETS
  NOTION
}

/// CONNECTING until the first copy is made; NEEDS_RECONNECT when the account's access was
/// revoked or expired; ERROR while writes keep failing (they are retried).
enum IntegrationStatus {
  CONNECTING
  ACTIVE
  PAUSED
  ERROR
  NEEDS_RECONNECT
}

/// A place a form's responses are copied to as they arrive: a Google Sheet, a Notion
/// database. One of each kind per form.
model Integration {
  id                   String              @id @default(cuid())
  formId               String              @map("form_id")
  kind                 IntegrationKind
  status               IntegrationStatus   @default(CONNECTING)
  /// Who connected it. Its access is theirs: if they leave, it needs connecting again.
  connectedById        String?             @map("connected_by_id")
  /// The account it writes as, for people to recognise ("ada@example.com").
  accountLabel         String?             @map("account_label")
  /// OAuth tokens, sealed with ENCRYPTION_KEYS (see lib/encryption.ts). Never sent to browsers.
  credentialsEncrypted String?             @map("credentials_encrypted")
  /// Where responses go and how questions map to its columns or properties (see
  /// packages/shared/src/integrations).
  config               Json                @default("{}")
  lastSyncedAt         DateTime?           @map("last_synced_at")
  lastError            String?             @map("last_error")
  lastErrorAt          DateTime?           @map("last_error_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  form                 Form                @relation(fields: [formId], references: [id], onDelete: Cascade)
  connectedBy          User?               @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  records              IntegrationRecord[]
  failures             JobFailure[]

  @@unique([formId, kind])
  @@map("integrations")
}

/// Where a response went in an integration (a sheet row's response id, a Notion page id), so
/// a changed response updates its copy instead of adding another.
model IntegrationRecord {
  integrationId String      @map("integration_id")
  submissionId  String      @map("submission_id")
  externalId    String      @map("external_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([integrationId, submissionId])
  @@map("integration_records")
}

/// A background job that ran out of tries (or failed for good), for the failed-jobs list. It
/// keeps the job's data, so Retry sends it again exactly.
model JobFailure {
  id            String       @id @default(cuid())
  /// The queue it ran on, e.g. "webhook.deliver".
  queue         String
  jobId         String       @map("job_id")
  formId        String?      @map("form_id")
  integrationId String?      @map("integration_id")
  webhookId     String?      @map("webhook_id")
  /// What the job was for, in a sentence.
  summary       String
  error         String
  attempts      Int
  data          Json
  createdAt     DateTime     @default(now()) @map("created_at")
  /// Retried or dismissed; resolved failures leave the list.
  resolvedAt    DateTime?    @map("resolved_at")
  form          Form?        @relation(fields: [formId], references: [id], onDelete: Cascade)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([formId, resolvedAt, createdAt(sort: Desc)])
  @@map("job_failures")
}

enum FeedbackKind {
  IDEA
  PROBLEM
  OTHER
}

/// What people tell us from the app's Feedback button.
model Feedback {
  id        String       @id @default(cuid())
  /// Who sent it; kept when they delete their account, without them.
  userId    String?      @map("user_id")
  kind      FeedbackKind
  message   String
  /// The app page it was sent from (a path, without its query), to reproduce problems.
  page      String?
  createdAt DateTime     @default(now()) @map("created_at")
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("feedback")
}

enum BillingInterval {
  MONTHLY
  YEARLY

  @@map("billing_interval")
}

/// A Razorpay subscription's status, as Razorpay names it.
enum SubscriptionStatus {
  /// Made, not paid for yet: Checkout has not finished.
  CREATED
  /// The payment method is authorised; the first charge is on its way.
  AUTHENTICATED
  ACTIVE
  /// A renewal failed; Razorpay is retrying.
  PENDING
  /// Every retry failed.
  HALTED
  CANCELLED
  /// Every billing cycle has been charged.
  COMPLETED
  EXPIRED
  PAUSED

  @@map("subscription_status")
}

/// A workspace's Razorpay subscription. Razorpay's webhooks keep it, and the workspace's plan,
/// up to date; the client is never trusted to say a payment went through.
model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String             @map("workspace_id")
  razorpaySubscriptionId String             @unique @map("razorpay_subscription_id")
  razorpayCustomerId     String?            @map("razorpay_customer_id")
  plan                   Plan
  interval               BillingInterval
  status                 SubscriptionStatus @default(CREATED)
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  /// Ends when the period it is in ends, instead of renewing.
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// Why the owner cancelled, if they said.
  cancelReason           String?            @map("cancel_reason")
  /// When Checkout's signature was checked on the server. The plan still waits for the
  /// webhook: a signature only says Checkout finished.
  verifiedAt             DateTime?          @map("verified_at")
  /// When the Razorpay event behind the current status happened, so an older event that
  /// arrives late does not undo a newer one.
  lastEventAt            DateTime?          @map("last_event_at")
  /// Who started it; kept, without them, if they delete their account.
  createdById            String?            @map("created_by_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments               Payment[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("subscriptions")
}

enum PaymentStatus {
  PAID
  FAILED

  @@map("payment_status")
}

/// A charge for a subscription, paid or failed.
model Payment {
  id                String        @id @default(cuid())
  workspaceId       String        @map("workspace_id")
  subscriptionId    String?       @map("subscription_id")
  razorpayPaymentId String        @unique @map("razorpay_payment_id")
  /// In paise.
  amount            Int
  currency          String
  status            PaymentStatus
  invoiceId         String?       @map("invoice_id")
  invoiceUrl        String?       @map("invoice_url")
  /// Razorpay's reason for a failed payment.
  failureReason     String?       @map("failure_reason")
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("payments")
}

/// Every Razorpay webhook received, by Razorpay's event id: a repeat is skipped. Processed by
/// the job queue, so the webhook answers at once.
model RazorpayEvent {
  /// Razorpay's X-Razorpay-Event-Id.
  id          String    @id
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  /// Why processing failed, the last time it did.
  error       String?

  @@index([receivedAt(sort: Desc)])
  @@map("razorpay_events")
}

/// A billing email or warning sent once: per workspace, kind (e.g. trial_reminder_7) and
/// period (the trial's end, a billing period's start).
model BillingNotice {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  kind        String
  periodKey   String    @map("period_key")
  sentAt      DateTime  @default(now()) @map("sent_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, periodKey])
  @@map("billing_notices")
}

/// What an admin did in /admin, kept for the record.
model AdminAction {
  id          String   @id @default(cuid())
  /// Kept, without them, if the admin deletes their account.
  adminId     String?  @map("admin_id")
  workspaceId String?  @map("workspace_id")
  action      String
  details     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  admin       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("admin_actions")
}

/// Lifecycle emails sent (welcome, first form published, first response, inactive): each kind
/// once per account and period, however often its trigger fires.
model LifecycleEmail {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// `welcome`, `first_form_published`, `first_response` or `inactive`.
  kind      String
  /// What makes a repeat a new email: "" for one-offs, the day they were last active for `inactive`.
  periodKey String   @default("") @map("period_key")
  sentAt    DateTime @default(now()) @map("sent_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey])
  @@map("lifecycle_emails")
}

/// Someone who signed up through a referral link, and the reward for whoever shared it.
model Referral {
  id                   String    @id @default(cuid())
  referrerId           String    @map("referrer_id")
  /// One referral per account: whoever's link they signed up through.
  friendId             String    @unique @map("friend_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  /// When the friend first paid, and the referrer got their month (null until then).
  rewardedAt           DateTime? @map("rewarded_at")
  /// `complimentary` (a month of Pro on their workspace) or `paused` (their own paid
  /// subscription skips a month).
  reward               String?
  rewardWorkspaceId    String?   @map("reward_workspace_id")
  /// For `paused`: the Razorpay subscription, and when the hourly job resumes it.
  pausedSubscriptionId String?   @map("paused_subscription_id")
  resumeAt             DateTime? @map("resume_at")
  resumedAt            DateTime? @map("resumed_at")
  referrer             User      @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  friend               User      @relation("friend", fields: [friendId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([resumeAt])
  @@map("referrals")
}
