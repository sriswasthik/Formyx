// Formyx database schema. After editing, run `pnpm db:migrate` to create a migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// What a member may do in a workspace. Ordered from most to least access.
enum Role {
  OWNER
  EDITOR
  VIEWER

  @@map("role")
}

model User {
  id            String             @id @default(cuid())
  name          String
  /// Stored trimmed and lowercased, so the unique index is effectively case-insensitive.
  email         String             @unique
  passwordHash  String             @map("password_hash")
  /// The shared demo account (see src/demo). It signs in without a password, its data is
  /// reset every night, and anything that reaches outside Formyx is switched off for it.
  isDemo        Boolean            @default(false) @map("is_demo")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  memberships   Membership[]
  forms         Form[]
  subscriptions FormSubscription[]
  invitesSent   Invite[]
  webhooks      Webhook[]

  @@map("users")
}

/// What a workspace pays for. Read through the shared entitlement helpers, never by name.
enum Plan {
  FREE
  PRO
  BUSINESS

  @@map("plan")
}

/// Where a workspace's billing stands; see `effectivePlan` in packages/shared.
enum PlanStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED

  @@map("plan_status")
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  /// No payments yet: every workspace is on FREE. ENTITLEMENTS_MODE decides whether it matters.
  plan        Plan         @default(FREE)
  planStatus  PlanStatus   @default(ACTIVE) @map("plan_status")
  /// When a TRIALING plan falls back to FREE.
  trialEndsAt DateTime?    @map("trial_ends_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  forms       Form[]
  invites     Invite[]

  @@map("workspaces")
}

model Membership {
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  role        Role
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One membership per user per workspace; the primary key also serves lookups by user.
  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

/// An invitation to join a workspace, sent by email. The link carries a random token; only
/// its SHA-256 is stored, so the table alone cannot be used to join.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  /// Stored trimmed and lowercased, like users' emails. Only this address can accept.
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String?   @map("invited_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Moves forward when the invite is sent again.
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@map("invites")
}

/// Where a form is in its life. Only PUBLISHED forms accept responses.
enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@map("form_status")
}

model Form {
  id              String             @id @default(cuid())
  workspaceId     String             @map("workspace_id")
  title           String
  /// Identifies the form's public link. Never changes, so shared links keep working.
  slug            String             @unique
  status          FormStatus         @default(DRAFT)
  /// The schema being edited. Every write is validated with the shared `formSchema`.
  draftSchema     Json               @map("draft_schema")
  /// What respondents see: a snapshot of the draft, taken each time the form is published.
  publishedSchema Json?              @map("published_schema")
  /// The title as last published, so renames go live with the next publish.
  publishedTitle  String?            @map("published_title")
  /// The look being edited. Validated with the shared `formThemeSchema`.
  theme           Json
  /// What respondents see: a snapshot of `theme`, taken each time the form is published.
  publishedTheme  Json?              @map("published_theme")
  /// Incremented on every draft update. Writers send the version they started from (optimistic concurrency).
  version         Int                @default(1)
  /// When the form was last published.
  publishedAt     DateTime?          @map("published_at")
  /// Null once the creator's account is deleted; the form stays with its workspace.
  createdById     String?            @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  submissions     Submission[]
  views           FormView[]
  subscriptions   FormSubscription[]
  webhooks        Webhook[]

  // The dashboard lists a workspace's forms, most recently edited first, optionally by status.
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([createdById])
  @@map("forms")
}

model Submission {
  id               String   @id @default(cuid())
  formId           String   @map("form_id")
  /// Answers keyed by field id, validated and normalised with the published schema.
  answers          Json
  /// Milliseconds from opening the form to submitting it, as measured by the browser.
  completionTimeMs Int?     @map("completion_time_ms")
  /// Client details: user agent and referrer. IP addresses are never stored.
  metadata         Json
  createdAt        DateTime @default(now()) @map("created_at")
  form             Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  // Responses are counted per form and listed newest first.
  @@index([formId, createdAt(sort: Desc)])
  @@map("submissions")
}

/// One visit to a published form, recorded once per browser session. Rows rather than a
/// counter, so views can be charted over time and compared with submissions.
model FormView {
  id        String   @id @default(cuid())
  formId    String   @map("form_id")
  createdAt DateTime @default(now()) @map("created_at")
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@map("form_views")
}

/// A member who wants an email about each new response to a form. Each member decides for
/// themselves, and it takes effect at once rather than with the next publish.
model FormSubscription {
  userId    String   @map("user_id")
  formId    String   @map("form_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@id([userId, formId])
  // A new response looks up who to email by form.
  @@index([formId])
  @@map("form_subscriptions")
}

/// A URL that gets a signed POST for each new response to a form.
model Webhook {
  id              String            @id @default(cuid())
  formId          String            @map("form_id")
  url             String
  /// The signing secret, encrypted with a key derived from JWT_SECRET (see webhook-signature.ts).
  /// It is shown once, when the webhook is added; Formyx needs it back only to sign requests.
  secretEncrypted String            @map("secret_encrypted")
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  form            Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deliveries      WebhookDelivery[]

  @@index([formId])
  @@map("webhooks")
}

/// One attempt to deliver an event; the newest few per webhook are kept for its log.
model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String   @map("webhook_id")
  /// Shared by every attempt at one event; sent as X-Formyx-Delivery.
  eventId    String   @map("event_id")
  event      String
  attempt    Int
  succeeded  Boolean
  /// The receiver's HTTP status; null when no response came back.
  statusCode Int?     @map("status_code")
  durationMs Int?     @map("duration_ms")
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}
